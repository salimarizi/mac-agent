# VPS gateway that fronts the connection and hosts the SSH reverse tunnel.
MAC_AGENT_VPS_HOST=''
MAC_AGENT_VPS_USER=''
MAC_AGENT_VPS_PORT='22'
MAC_AGENT_TUNNEL_PORT='9443'
MAC_AGENT_DOMAIN=''

# Passphrase-free key used for the tunnel. launchd has no ssh-agent, so the key
# must unlock without one.
MAC_AGENT_SSH_KEY=''

# Required: access password for the remote control.
MAC_AGENT_PASSWORD=''

# TURN relay. List every transport, comma-separated: a network that blocks UDP
# 3478 still has TCP and TLS-on-5349 to fall back to.
MAC_AGENT_TURN_URL='turn:HOST:3478?transport=udp,turn:HOST:3478?transport=tcp,turns:HOST:5349?transport=tcp'
MAC_AGENT_TURN_USER=''
MAC_AGENT_TURN_PASS=''

# STUN relay (optional). Defaults to Google + Cloudflare when unset.
MAC_AGENT_STUN_URLS='stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478'

# Capture tuning (optional).
MAC_AGENT_SCREEN_INDEX='0'
MAC_AGENT_FPS='30'
MAC_AGENT_WIDTH='1600'
MAC_AGENT_BITRATE='6M'
